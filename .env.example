# Copy this file to .env and fill it in, or run setup (python setup_jugnu.py), which writes it for you.
# Never commit .env.

# Which brain thinks: claude (default), openai (GPT), gemini, deepseek, xai (Grok),
# openrouter, ollama (a model on this computer) or custom (any OpenAI-style server).
# JUGNU_BRAIN=claude
# api (default): on that provider's API key, below. subscription: GPT on your ChatGPT plan,
# through Codex (npm install -g @openai/codex, then codex login); replies are a tad slower.
# JUGNU_BRAIN_AUTH=api
# For a brain other than Claude: its model for work, and optionally for conversation and
# "think hard" (both default to the work model). On a subscription, leave them to Codex.
# JUGNU_BRAIN_MODEL=
# JUGNU_BRAIN_FAST=
# JUGNU_BRAIN_DEEP=
# custom or ollama only: the server's address (ending in /v1); custom's key, if it needs one
# JUGNU_BRAIN_URL=http://localhost:11434/v1
# JUGNU_BRAIN_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# Claude as the brain, on your Claude Pro/Max plan: sign in to Claude Code once (setup's
# "Sign in to Claude", or: claude auth login) and leave this empty; Jugnu runs on that sign-in.
# Or an Anthropic API key (billed per token):
ANTHROPIC_API_KEY=

# Three brains, picked per request: Haiku for conversation (quickest), Sonnet when
# there's work in it (reading, searching, files, papers, code, the browser), Opus
# when you say "think hard about..." or "ask Opus...".
# JUGNU_FAST_MODEL=claude-haiku-5-5
JUGNU_MODEL=sonnet
# JUGNU_DEEP_MODEL=opus

# The council (optional): who sits on it, from claude, gpt, gemini, deepseek, xai, openrouter, ollama, custom (the brain never sits on its
# own council). Claude needs no key: it uses your Claude Code sign-in (setup signs you in). GPT needs
# no key: it uses Codex on your ChatGPT plan (npm install -g @openai/codex, then codex login; a Codex
# inside WSL works too). Gemini and DeepSeek need their keys below.
# JUGNU_COUNCIL=gpt,gemini,deepseek
# JUGNU_COUNCIL_CLAUDE=opus
# Seats on any OpenAI-style API (xai, openrouter, ollama, custom), with the model named here.
# Grok and OpenRouter share the brain's keys (XAI_API_KEY, OPENROUTER_API_KEY).
# COUNCIL_XAI_MODEL=
# COUNCIL_OPENROUTER_MODEL=
# COUNCIL_OLLAMA_MODEL=
# Grok, OpenRouter and the local model can also audit a folder hands-on, in the Docker container (Codex
# drives Grok; Claude Code drives the other two). For the local one, Ollama must accept connections from
# Docker: set OLLAMA_HOST=0.0.0.0
# COUNCIL_CUSTOM_URL=
# COUNCIL_CUSTOM_KEY=
# COUNCIL_CUSTOM_MODEL=
# Anything the council must never be sent, in plain words (e.g. "my day job at Acme"). Empty = no limit.
# JUGNU_NO_SHARE=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Defaults are each one's strongest model. Set these only to override.
# DEEPSEEK_MODEL=deepseek-v4-pro
# GEMINI_MODEL=gemini-4-carbon   (the council's Gemini: its strongest; if your key can't use it, the next one it can)
# "Switch to Argon": the Gemini model that takes over as the brain (needs GEMINI_API_KEY)
# JUGNU_ARGON_MODEL=gemini-4-argon

# The council, hands-on (audits in Docker; see README). GPT's models in order: one that isn't on
# your plan passes to the next.
# JUGNU_GPT_MODELS=gpt-6-astra,gpt-6.1-sol,gpt-5.6-sol
# Minutes each member may work, how many work at once, and the memory each container gets
# JUGNU_AGENT_MINUTES=30
# JUGNU_AUDITORS_AT_ONCE=1
# JUGNU_AUDITOR_MEMORY=8g
# Where their findings and transcripts go (default: Documents\Jugnu workspaces), and the image's name
# JUGNU_WORKSPACES=
# JUGNU_AUDITOR_IMAGE=jugnu-auditor
# Docker Desktop, if it isn't in C:\Program Files\Docker\Docker; Ollama's address as a container sees it
# JUGNU_DOCKER_DESKTOP=
# JUGNU_OLLAMA_FROM_DOCKER=http://host.docker.internal:11434
# GPT as the brain on your ChatGPT plan: how to start Codex, if it isn't on PATH or in WSL
# JUGNU_CODEX=

# Voice and ears: google (default: the keys below) or local (Chatterbox and Whisper on this
# computer's NVIDIA GPU, about 4 GB free; nothing goes to Google, and no Google keys are needed).
# JUGNU_SENSES=google
# The voice: Google Chirp 3 HD with this key (restrict it to the Text-to-Speech API). off = silent
JUGNU_VOICE=on
GOOGLE_TTS_API_KEY=
# JUGNU_GOOGLE_VOICE=en-IN-Chirp3-HD-Algieba
# The ears (Google Speech-to-Text, streamed).
# Needs your Cloud project's ID, and your Google login saved once with
# `gcloud auth application-default login` (Chirp 3 doesn't take API keys).
JUGNU_EARS=on
JUGNU_GOOGLE_PROJECT=
# JUGNU_STT_REGION=eu   (or us)
# Your accent, as Google names it: en-IN (default), en-US, en-GB, en-AU...
# JUGNU_STT_LANGUAGE=en-IN
# How soon Google decides a pause ends what you said: supershort (default), short or standard
# JUGNU_STT_ENDPOINTING=supershort
# A spoken sentence as a WAV, for timing the ears with: python ears.py google
# JUGNU_TEST_CLIP=
# Seconds of quiet before it answers, if what you said sounds finished (longer = fewer interruptions)
# JUGNU_PAUSE=1.0
# Private mode's Whisper; the bigger (slower, ~3 GB) openai/whisper-large-v3 is better with accents
# JUGNU_WHISPER=openai/whisper-large-v3-turbo
# What Jugnu calls you (e.g. boss): in its greeting, and instead of your first name
JUGNU_USER=
# Which microphone to use: parts of mic names, in order of preference. The first
# one plugged in wins, so headphones can come and go. `python ears.py mics` lists
# them and shows how loud you come through. With Bluetooth headphones prefer the
# laptop mic: a "Hands-Free" mic is phone-call quality and puts them in call mode.
# JUGNU_MIC=microphone array

# Browser control (needs Node.js: scoop install nodejs-lts). Where it browses:
#   own     a browser of Jugnu's own, in a window apart from yours; sign in there once per site, and every
#           brain you switch to shares it (the default)
#   hidden  the same, with its window kept out of sight
#   chrome  your own Chrome, signed in as you are, through the "Playwright MCP Bridge" extension; if the
#           extension shows a token, put it below so it doesn't ask you to approve every connection
#   off     no browser
# Either way, "show the browser" and "hide the browser" bring its window out and put it away.
# JUGNU_BROWSER=own
# PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# Google Drive, Docs and Sheets (optional). An OAuth client from your own Google Cloud
# project: see "Google Drive" in README.md. Deleting and sharing are always off.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=
# Folders Jugnu may upload to Drive from (';'-separated). Default: your home folder
# JUGNU_UPLOAD_DIRS=C:\Users\you;D:\Projects

# Where written reports and saved conversations go (default: Documents\Jugnu reports)
# JUGNU_REPORTS=

# If it misses your normal speaking voice. Lower threshold = hears softer speech (0.3-0.5,
# default 0.35); gain boosts a quiet or far mic (1.0-4.0, default 1.5). Check levels first
# with: .venv\Scripts\python ears.py mics
# JUGNU_HEAR_THRESHOLD=0.35
# How alike a voice must be to yours to count, once it has learned yours ("learn my voice"): raise it if other
# people get through, lower it if it stops hearing you. The log shows the number for everything it hears.
# JUGNU_VOICE_MATCH=0.40
# JUGNU_MIC_GAIN=2.0

# Setup's look: light or dark (the button at the top right of setup sets it). Unset: follows Windows.
# JUGNU_THEME=
